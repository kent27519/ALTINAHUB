	local Header = Instance.new("TextLabel")
	Header.Size = UDim2.new(1, -16, 0, 28)
	Header.Position = UDim2.new(0, 10, 0, 6)
	Header.BackgroundTransparency = 1
	Header.Text = title
	Header.Font = Enum.Font.GothamBold
	Header.TextSize = 13
	Header.TextColor3 = Color3.fromRGB(255, 120, 120)
	Header.TextXAlignment = Enum.TextXAlignment.Left
	Header.Parent = Section

	return Section
end

local function CreateToggle(parent, text, yPos, default, callback)
	local Btn = Instance.new("TextButton")
	Btn.Size = UDim2.new(1, -20, 0, 32)
	Btn.Position = UDim2.new(0, 10, 0, yPos)
	Btn.BackgroundColor3 = default and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(40, 40, 50)
	Btn.Text = ""
	Btn.AutoButtonColor = false
	Btn.Parent = parent

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 7)
	Corner.Parent = Btn

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -50, 1, 0)
	Label.Position = UDim2.new(0, 10, 0, 0)
	Label.BackgroundTransparency = 1
	Label.Text = text
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 13
	Label.TextColor3 = Color3.fromRGB(230, 230, 240)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Btn

	local Status = Instance.new("TextLabel")
	Status.Size = UDim2.new(0, 40, 1, 0)
	Status.Position = UDim2.new(1, -45, 0, 0)
	Status.BackgroundTransparency = 1
	Status.Text = default and "✓" or " "
	Status.Font = Enum.Font.GothamBold
	Status.TextSize = 16
	Status.TextColor3 = default and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(140, 140, 150)
	Status.Parent = Btn

	local state = default
	Btn.MouseButton1Click:Connect(function()
		state = not state
		Btn.BackgroundColor3 = state and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(40, 40, 50)
		Status.Text = state and "✓" or " "
		Status.TextColor3 = state and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(140, 140, 150)
		if callback then callback(state) end
	end)
	return Btn
end

local function CreateCheckGrid(parent, items, startY, columns, stateTable)
	local y = startY
	local x = 10
	local count = 0

	for _, name in ipairs(items) do
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(0, 90, 0, 28)
		Btn.Position = UDim2.new(0, x, 0, y)
		Btn.BackgroundColor3 = stateTable[name] and Color3.fromRGB(50, 120, 180) or Color3.fromRGB(40, 40, 50)
		Btn.Text = name
		Btn.Font = Enum.Font.Gotham
		Btn.TextSize = 11
		Btn.TextColor3 = Color3.fromRGB(230, 230, 240)
		Btn.Parent = parent

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Btn

		local state = stateTable[name]
		Btn.MouseButton1Click:Connect(function()
			state = not state
			stateTable[name] = state
			Btn.BackgroundColor3 = state and Color3.fromRGB(50, 120, 180) or Color3.fromRGB(40, 40, 50)
		end)

		count = count + 1
		x = x + 95
		if count % columns == 0 then
			x = 10
			y = y + 34
		end
	end
	return y + 34
end

