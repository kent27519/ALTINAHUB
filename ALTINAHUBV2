local function CreateToggle(parent, text, callback)
    local toggled = false
    local frame = Instance.new("TextButton")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    frame.Size = UDim2.new(1, -10, 0, 32)
    frame.AutoButtonColor = false
    frame.Text = ""
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel")
    lbl.Parent = frame
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local indicator = Instance.new("TextLabel")
    indicator.Parent = frame
    indicator.BackgroundTransparency = 1
    indicator.Position = UDim2.new(1, -35, 0, 0)
    indicator.Size = UDim2.new(0, 30, 1, 0)
    indicator.Font = Enum.Font.GothamBold
    indicator.Text = "( )"
    indicator.TextColor3 = Color3.fromRGB(200, 50, 50)
    indicator.TextSize = 12
    
    frame.MouseButton1Click:Connect(function()
        toggled = not toggled
        indicator.Text = toggled and "(✓)" or "( )"
        indicator.TextColor3 = toggled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
        if callback then callback(toggled) end
    end)
end

local function CreateDropdown(parent, text, options, callback)
    local dropdownOpen = false
    local container = Instance.new("Frame")
    container.Parent = parent
    container.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    container.Size = UDim2.new(1, -10, 0, 32)
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
    
    local btn = Instance.new("TextButton")
    btn.Parent = container
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.Font = Enum.Font.Gotham
    btn.Text = "  " .. text .. ": Select..."
    btn.TextColor3 = Color3.fromRGB(220, 220, 230)
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Parent = container
    listFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    listFrame.Position = UDim2.new(0, 0, 1, 4)
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.Visible = false
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #options * 26)
    listFrame.ScrollBarThickness = 2
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)
    
    local layout = Instance.new("UIListLayout")
    layout.Parent = listFrame
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Parent = listFrame
        optBtn.BackgroundTransparency = 1
        optBtn.Size = UDim2.new(1, 0, 0, 26)
        optBtn.Font = Enum.Font.Gotham
        optBtn.Text = "   " .. opt
        optBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
        optBtn.TextSize = 11
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        
        optBtn.MouseButton1Click:Connect(function()
            btn.Text = "  " .. text .. ": " .. opt
            dropdownOpen = false
            listFrame.Visible = false
            container.Size = UDim2.new(1, -10, 0, 32)
            if callback then callback(opt) end
        end)
    end
    
    btn.MouseButton1Click:Connect(function()
        dropdownOpen = not dropdownOpen
        listFrame.Visible = dropdownOpen
        container.Size = UDim2.new(1, -10, 0, dropdownOpen and math.clamp(#options * 26 + 36, 36, 150) or 32)
    end)
end

local function CreateSlider(parent, text, min, max, callback)
    local container = Instance.new("Frame")
    container.Parent = parent
    container.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    container.Size = UDim2.new(1, -10, 0, 50)
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel")
    lbl.Parent = container
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, 5)
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text .. ": " .. min
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local sliderBg = Instance.new("Frame")
    sliderBg.Parent = container
    sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    sliderBg.Position = UDim2.new(0, 10, 0, 30)
    sliderBg.Size = UDim2.new(1, -20, 0, 6)
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Parent = sliderBg
    sliderFill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    sliderFill.Size = UDim2.new(0, 0, 1, 0)
    Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            sliderFill.Size = UDim2.new(pos, 0, 1, 0)
            local val = math.floor(min + (max - min) * pos)
            lbl.Text = text .. ": " .. val
            if callback then callback(val) end
        end
    end)
end

