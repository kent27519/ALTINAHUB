--==================================================
-- EGG STEALING LOGIC
--==================================================

local function getSelectedRarityNames()
	local rarityNames = {}
	for rarity in pairs(config.selectedRarities) do
		table.insert(rarityNames, rarity:lower())
	end
	return rarityNames
end

local function findEggByRarity()
	local selectedRarities = getSelectedRarityNames()
	if #selectedRarities == 0 then return nil end
	
	local workspace = game:GetService("Workspace")
	local eggFolder = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("eggs")
	
	if not eggFolder then return nil end
	
	-- Find the closest egg matching any selected rarity
	local closestEgg = nil
	local closestDistance = math.huge
	local character = player.Character
	
	if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	
	local playerPos = character.HumanoidRootPart.Position
	
	for _, egg in pairs(eggFolder:GetChildren()) do
		local eggName = egg.Name:lower()
		
		for _, rarityName in pairs(selectedRarities) do
			if eggName:find(rarityName) then
				local eggPos = egg:IsA("BasePart") and egg.Position or (egg:FindFirstChild("PrimaryPart") and egg.PrimaryPart.Position or egg.Position)
				local distance = (eggPos - playerPos).Magnitude
				
				if distance < closestDistance then
					closestDistance = distance
					closestEgg = {egg = egg, rarityName = rarityName, position = eggPos, distance = distance}
				end
				break
			end
		end
	end
	
	return closestEgg
end

local function moveToPosition(targetPos, onArrival)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	
	local humanoidRootPart = character.HumanoidRootPart
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	if not humanoid or humanoid.Health <= 0 then return false end
	
	local startTime = tick()
	local moveSpeed = config.moveSpeed
	
	while config.autoStealEnabled and character.Parent and humanoid.Health > 0 do
		local currentPos = humanoidRootPart.Position
		local direction = (targetPos - currentPos)
		local distance = direction.Magnitude
		
		if distance < 5 then
			if onArrival then onArrival() end
			return true
		end
		
		-- Move towards target
		humanoidRootPart.CFrame = humanoidRootPart.CFrame + (direction.Unit * moveSpeed * 0.016)
		task.wait(0.016)
	end
	
	return false
end

local function collectEgg(egg)
	local character = player.Character
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	-- Try different collection methods
	for i = 1, 20 do
		if not config.autoStealEnabled then return end
		
		-- Method 1: ClickDetector
		local clickDetector = egg:FindFirstChild("ClickDetector")
		if clickDetector then
			clickDetector:FireServer()
		end
		
		-- Method 2: ProximityPrompt
		local prompt = egg:FindFirstChild("ProximityPrompt")
		if prompt then
			prompt:InputHoldBegin()
			task.wait(0.3)
			prompt:InputHoldEnd()
		end
		
		-- Method 3: Touch
		humanoidRootPart.CFrame = humanoidRootPart.CFrame + Vector3.new(0, 0, -2)
		task.wait(0.1)
	end
end

local function returnToSpawn()
	if not config.spawnPoint then return true end
	
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	
	print("Returning to spawn...")
	return moveToPosition(config.spawnPoint.Position, function()
		print("Reached spawn point!")
	end)
end

--==================================================
-- MAIN AUTO STEAL LOOP
--==================================================

task.spawn(function()
	while true do
		if config.autoStealEnabled then
			local character = player.Character
			
			if character and character:FindFirstChild("HumanoidRootPart") then
				local eggData = findEggByRarity()
				
				if eggData then
					local eggName = eggData.egg.Name
					print("🎯 Found " .. eggName .. " at distance: " .. math.floor(eggData.distance) .. " studs")
					
					-- Move to egg
					if moveToPosition(eggData.position, function()
						print("📍 Reached " .. eggName)
					end) then
						-- Collect egg
						print("✨ Collecting " .. eggName)
						collectEgg(eggData.egg)
						task.wait(1)
						
						-- Return to spawn
						returnToSpawn()
						task.wait(0.5)
					end
				else
					-- No egg found, wait a bit
					task.wait(0.5)
				end
			else
				task.wait(0.5)
			end
		else
			task.wait(0.1)
		end
	end
end)

