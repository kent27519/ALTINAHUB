--// THEME
local BG = Color3.fromRGB(8, 8, 20)
local PANEL = Color3.fromRGB(15, 14, 32)
local PURPLE = Color3.fromRGB(130, 45, 255)
local TEXT = Color3.fromRGB(245, 240, 255)
local MUTED = Color3.fromRGB(170, 160, 195)

local function corner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = obj
end

local function stroke(obj)
	local s = Instance.new("UIStroke")
	s.Color = PURPLE
	s.Thickness = 1
	s.Transparency = 0.35
	s.Parent = obj
end

local function label(parent, text, size, pos)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = TEXT
	l.TextSize = size or 12
	l.Font = Enum.Font.GothamSemibold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Position = pos
	l.Size = UDim2.new(1, 0, 0, 22)
	l.Parent = parent
	return l
end

local function button(parent, text)
	local b = Instance.new("TextButton")
	b.Text = text
	b.TextColor3 = TEXT
	b.TextSize = 11
	b.Font = Enum.Font.GothamSemibold
	b.BackgroundColor3 = PANEL
	b.AutoButtonColor = false
	b.Size = UDim2.new(0, 82, 0, 27)
	b.Parent = parent
	corner(b, 7)
	stroke(b)

	b.MouseButton1Click:Connect(function()
		b.BackgroundColor3 =
			b.BackgroundColor3 == PURPLE and PANEL or PURPLE
	end)

	return b
end

local function toggle(parent, name)
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = "OFF"
	b.TextColor3 = TEXT
	b.TextSize = 10
	b.Font = Enum.Font.GothamBold
	b.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
	b.Size = UDim2.new(0, 58, 0, 24)
	b.AutoButtonColor = false
	b.Parent = parent
	corner(b, 12)

	b.MouseButton1Click:Connect(function()
		if b.Text == "OFF" then
			b.Text = "✓ ON"
			b.BackgroundColor3 = PURPLE
		else
			b.Text = "OFF"
			b.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
		end
	end)

	return b
end

