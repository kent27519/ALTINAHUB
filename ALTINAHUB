local function toggle(parent, text, y)
	local label = makeLabel(
		parent,
		text,
		UDim2.new(.025,0,y,0),
		UDim2.new(.55,0,.13,0)
	)

	local b = makeButton(
		parent,
		"●",
		UDim2.new(.83,0,y-.01,0),
		UDim2.new(.10,0,.13,0)
	)

	local enabled = true

	b.MouseButton1Click:Connect(function()
		enabled = not enabled

		if enabled then
			b.Text = "●"
			b.BackgroundColor3 = BLUE
		else
			b.Text = "○"
			b.BackgroundColor3 = BUTTON
		end
	end)

	return b
end

