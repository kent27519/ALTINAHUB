--==================================================
-- PANEL FUNCTION
--==================================================

local function makePanel(name, pos, size)
	local p = Instance.new("Frame")
	p.Name = name
	p.Position = pos
	p.Size = size
	p.BackgroundColor3 = PANEL
	p.BorderSizePixel = 0
	p.Parent = content

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = p

	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(13, 53, 80)
	s.Thickness = 1
	s.Parent = p

	return p
end

--==================================================
-- BUTTON FUNCTION
--==================================================

local function makeButton(parent, text, pos, size)
	local b = Instance.new("TextButton")
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = BUTTON
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = WHITE
	b.TextScaled = true
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	b.Parent = parent

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 9)
	c.Parent = b

	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(28, 72, 105)
	s.Thickness = 1
	s.Parent = b

	return b
end

local function makeLabel(parent, text, pos, size)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position = pos
	l.Size = size
	l.Text = text
	l.TextColor3 = WHITE
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

