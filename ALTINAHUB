--==================================================
-- EGG FINDING & STEALING LOGIC
--==================================================

local function getEggFolders()
	local workspace = game:GetService("Workspace")
	local folderNames = {"Eggs", "eggs", "EggSpawns", "eggSpawns", "Items", "items"}
	
	for _, folderName in ipairs(folderNames) do
		local folder = workspace:FindFirstChild(folderName)
		if folder then return {folder} end
	end
	return {}
end

local function findEggByRarity()
	local selectedRarities = {}
	for rarity in pairs(config.selectedRarities) do
		table.insert(selectedRarities, rarity:lower())
	end
	
	if #selectedRarities == 0 then return nil end
	
	local eggFolders = getEggFolders()
	if #eggFolders == 0 then return nil end
	
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	
	local playerPos = character.HumanoidRootPart.Position
	local closestEgg = nil
	local closestDistance = math.huge
	
	for _, folder in ipairs(eggFolders) do
		for _, egg in pairs(folder:GetChildren()) do
			local eggName = egg.Name:lower()
			
			for _, rarityName in ipairs(selectedRarities) do
				if eggName:find(rarityName) then
					local eggPos = egg:IsA("BasePart") and egg.Position or (egg:FindFirstChild("PrimaryPart") and egg.PrimaryPart.Position)
					
					if eggPos then
						local distance = (eggPos - playerPos).Magnitude
						
						if distance < closestDistance then
							closestDistance = distance
							closestEgg = {
								egg = egg,
								rarityName = rarityName,
								position = eggPos,
								distance = distance,
								name = egg.Name
							}
						end
					end
					break
				end
			end
		end
	end
	
	return closestEgg
end

local function moveToPosition(targetPos, maxWait)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	
	local humanoidRootPart = character.HumanoidRootPart
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	if not humanoid or humanoid.Health <= 0 then return false end
	
	local startTime = tick()
	local moveSpeed = config.moveSpeed / 10
	maxWait = maxWait or 30
	
	while config.autoStealEnabled and character.Parent and humanoid.Health > 0 do
		local currentPos = humanoidRootPart.Position
		local direction = (targetPos - currentPos)
		local distance = direction.Magnitude
		
		if distance < 3 then
			return true
		end
		
		if tick() - startTime > maxWait then
			return false
		end
		
		humanoidRootPart.CFrame = humanoidRootPart.CFrame + (direction.Unit * moveSpeed * 0.016)
		task.wait(0.016)
	end
	
	return false
end

local function collectEgg(egg)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	
	local humanoidRootPart = character.HumanoidRootPart
	
	-- Method 1: ProximityPrompt
	for i = 1, 5 do
		if not config.autoStealEnabled then return false end
		
		local prompt = egg:FindFirstChild("ProximityPrompt")
		if prompt then
			prompt:InputHoldBegin()
			task.wait(0.5)
			prompt:InputHoldEnd()
			return true
		end
		task.wait(0.1)
	end
	
	-- Method 2: ClickDetector
	for i = 1, 5 do
		if not config.autoStealEnabled then return false end
		
		local clickDetector = egg:FindFirstChild("ClickDetector")
		if clickDetector then
			task.wait(0.2)
			return true
		end
		task.wait(0.1)
	end
	
	-- Method 3: Teleport and touch
	for i = 1, 15 do
		if not config.autoStealEnabled then return false end
		humanoidRootPart.CFrame = egg.CFrame + Vector3.new(0, 2, 0)
		task.wait(0.1)
	end
	
	return true
end

local function returnToSpawn()
	if not config.spawnPoint then return true end
	
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	
	print("🏠 Returning to spawn...")
	return moveToPosition(config.spawnPoint.Position, 20)
end

